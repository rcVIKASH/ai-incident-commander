{
  "name": "ai_incident_commander",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prisma:generate:core": "prisma generate --config prisma.core.config.ts",
    "prisma:generate:telemetry": "prisma generate --config prisma.telemetry.config.ts",
    "prisma:generate": "npm run prisma:generate:core && npm run prisma:generate:telemetry",
    "prisma:migrate:core": "prisma migrate dev --config prisma.core.config.ts",
    "prisma:migrate:telemetry": "prisma migrate dev --config prisma.telemetry.config.ts",
    "prisma:deploy:core": "prisma migrate deploy --config prisma.core.config.ts",
    "prisma:deploy:telemetry": "prisma migrate deploy --config prisma.telemetry.config.ts",
    "prisma:status:core": "prisma migrate status --config prisma.core.config.ts",
    "prisma:status:telemetry": "prisma migrate status --config prisma.telemetry.config.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/index.js",
    "dev": "tsc && npm run start",
    "test:graph": "tsc && node dist/langGraph/testGraph.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@langchain/core": "^1.2.6",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/openrouter": "^0.4.7",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  }
}
