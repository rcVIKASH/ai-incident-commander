{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./app",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["app/**/*.ts", "app/pubSub/test.js", "app/pubSub/test2.js"],
  "exclude": ["dist", "node_modules"]
}